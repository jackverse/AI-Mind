<?xml version="1.0" encoding="utf-8"?>
<!-- 版本号不写在这里：aapt2 link 的 versionCode/versionName 参数只在清单没写时才注入，
     两处都放会互相打架（当年就出过「改了参数 APK 还是 1.2」）。版本号统一由
     tools\android-app\build.ps1 的 VersionName/VersionCode 参数决定，发版走 tools\release.ps1。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jackverse.secondbrain">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 自更新：下载完 APK 后拉起系统安装器（仍要用户点一次「安装」） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 任何 app「分享」文字/文件过来都能收到 → 落 notes/inbox/ -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/markdown" />
            </intent-filter>
        </activity>

        <!-- 抖音登录页：独立 Activity 才能让软键盘正常弹出（对话框窗口里键盘唤不出来）。
             注意：这一条必须和 DouyinLoginActivity.java 一起存在，漏了会在点「登录新账号」时
             ActivityNotFoundException 直接闪退（v1.20.0/1.20.1 就是这么挂的）。build.ps1 里有校验。 -->
        <activity
            android:name=".DouyinLoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="com.jackverse.secondbrain.ApkProvider"
            android:authorities="com.jackverse.secondbrain.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
